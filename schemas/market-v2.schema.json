{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0857ken/tw-market-scanner/main/schemas/market-v2.schema.json",
  "title": "TW Market Scanner audited EOD contract v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "asOf",
    "generatedAt",
    "sources",
    "stocks",
    "indexHistory",
    "futures",
    "creditHistory",
    "creditRule"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "mode": {
      "enum": [
        "live",
        "unavailable"
      ]
    },
    "asOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stock"
      }
    },
    "indexHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/price"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "futures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "contract",
          "unit",
          "foreign",
          "trust",
          "dealer"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "contract": {
            "const": "TX"
          },
          "unit": {
            "const": "contracts"
          },
          "foreign": {
            "type": "integer"
          },
          "trust": {
            "type": "integer"
          },
          "dealer": {
            "type": "integer"
          }
        }
      }
    },
    "creditHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "hyg",
          "shy"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "hyg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "shy": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "spy": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "creditRule": {
      "type": "object",
      "required": [
        "status",
        "window"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "confirmed"
          ]
        },
        "window": {
          "const": 189
        }
      }
    }
  },
  "$defs": {
    "price": {
      "type": "object",
      "required": [
        "date",
        "close"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "close": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "volumeShares": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "changeAmount": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "stock": {
      "type": "object",
      "required": [
        "symbol",
        "name",
        "history"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "name": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/price"
          }
        },
        "marketCapM": {
          "type": [
            "number",
            "null"
          ]
        },
        "priceBasis": {
          "enum": [
            "unadjusted",
            "adjusted-total-return"
          ]
        },
        "institutional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/institutional"
          }
        },
        "margin": {
          "$ref": "#/$defs/margin"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "status",
        "asOf"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "fresh",
            "stale",
            "error",
            "unknown",
            "unavailable",
            "imported"
          ]
        },
        "asOf": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "institutional": {
      "type": "object",
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "foreignShares": {
          "type": [
            "number",
            "null"
          ]
        },
        "trustShares": {
          "type": [
            "number",
            "null"
          ]
        },
        "dealerShares": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalShares": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "margin": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "balanceShares": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "limitShares": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "usagePct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
